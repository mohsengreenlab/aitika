# App Config
APP_PORT=3000
NODE_ENV=development

JWT_SECRET=replace_this_with_a_strong_secret
JWT_EXPIRES_IN=1h

JWT_REFRESH_SECRET=replace_this_with_another_secret
JWT_REFRESH_EXPIRES_IN=7d

# Database
DB_NAME=aitika
DB_USER=user
DB_PW=pass
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://user:pass@localhost:5432/aitika?schema=public

# Redis Config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=productionOnly

# Dev Tools 
REDIS_UI_PORT=5540
PG_ADMIN_PORT=5050